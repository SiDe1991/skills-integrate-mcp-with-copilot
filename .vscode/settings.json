        "/^python3 - <<'PY'\nimport json, os, urllib\\.request\n\ntoken = os\\.environ\\.get\\('GITHUB_TOKEN'\\)\nrepo = os\\.environ\\.get\\('GITHUB_REPOSITORY'\\) or 'SiDe1991/skills-integrate-mcp-with-copilot'\nif not token:\n    raise SystemExit\\('GITHUB_TOKEN not set'\\)\n\nissues = \\[\n    \\{\n        'title': 'Add admin dashboard for extracurricular management',\n        'body': '''## Summary\nCreate an admin dashboard to manage extracurricular activities, club information, and student registrations\\.\n\n## Why\nThe current app only supports viewing and joining activities\\. A coordinator needs a way to administer the program without directly editing code\\.\n\n## Proposed features\n- Add, edit, and delete activities\n- View participant lists for each activity\n- Track activity capacity and enrollment\n- Approve or reject activity requests\n- Manage club leaders and faculty contacts\n\n## Acceptance criteria\n- Admins can log in and access a dashboard\n- They can add an activity with description, schedule, and capacity\n- They can update or remove activities\n- They can see current participants and enrollment counts\n'''\n    \\},\n    \\{\n        'title': 'Add calendar and scheduling views for activities',\n        'body': '''## Summary\nAdd a calendar-based view so students and staff can see upcoming extracurricular events and schedules more clearly\\.\n\n## Why\nRight now activities are listed as text; there is no time-based view or planning interface\\.\n\n## Proposed features\n- Weekly and monthly calendar views\n- Activity time, date, and venue details\n- Search and filter by day or category\n- Show upcoming events first\n- Highlight full or near-full sessions\n\n## Acceptance criteria\n- Users can switch between list and calendar views\n- Events display date, time, and category\n- Upcoming events are easy to scan and filter\n'''\n    \\},\n    \\{\n        'title': 'Implement attendance tracking for extracurricular activities',\n        'body': '''## Summary\nTrack which students attend each activity and keep a history of participation\\.\n\n## Why\nThe project currently records membership but not actual attendance or engagement\\.\n\n## Proposed features\n- Mark students present or absent\n- Store attendance records per session\n- Show attendance summary by student and by activity\n- Identify students with repeated participation\n\n## Acceptance criteria\n- Staff can record attendance for each activity session\n- Attendance history is saved and displayed\n- Students can view their own attendance summary\n'''\n    \\},\n    \\{\n        'title': 'Add student profiles and role-based access',\n        'body': '''## Summary\nCreate student profiles and a role system for students, club leaders, and staff\\.\n\n## Why\nThe app currently identifies students only by email and does not support different user roles or managing personal details\\.\n\n## Proposed features\n- Student profile with name, grade, and interests\n- Role-based access: student, club leader, staff, admin\n- Student participation history\n- Leader-specific activity management rights\n\n## Acceptance criteria\n- Users can sign in as different roles\n- Role-based permissions are enforced\n- Students can see their activity history and profile\n- Club leaders can manage their assigned activities\n'''\n    \\},\n    \\{\n        'title': 'Replace in-memory storage with a persistent database and authentication',\n        'body': '''## Summary\nMove the app from in-memory data to a real persistent backend with secure authentication\\.\n\n## Why\nThe current app resets data on restart and has no user authentication or database persistence\\.\n\n## Proposed features\n- Store activities, registrations, and profiles in a database\n- Add login and signup flows\n- Protect admin-only routes\n- Ensure data persists across restarts\n- Support secure session or token-based auth\n\n## Acceptance criteria\n- Activities and participant data persist after server restart\n- Only authorized users can manage sensitive data\n- User authentication works for student and admin flows\n- The app can scale beyond temporary in-memory data\n'''\n    \\}\n\\]\n\nurl = f'https://api\\.github\\.com/repos/\\{repo\\}/issues'\nheaders = \\{\n    'Authorization': f'Bearer \\{token\\}',\n    'Accept': 'application/vnd\\.github\\+json',\n    'X-GitHub-Api-Version': '2022-11-28',\n    'User-Agent': 'copilot-agent'\n\\}\n\nfor issue in issues:\n    payload = json\\.dumps\\(\\{\n        'title': issue\\['title'\\],\n        'body': issue\\['body'\\],\n        'labels': \\['enhancement'\\]\n    \\}\\)\\.encode\\(\\)\n    req = urllib\\.request\\.Request\\(url, data=payload, headers=headers, method='POST'\\)\n    with urllib\\.request\\.urlopen\\(req\\) as resp:\n        data = json\\.loads\\(resp\\.read\\(\\)\\.decode\\(\\)\\)\n        print\\(f\"Created: #\\{data\\['number'\\]\\} - \\{data\\['title'\\]\\} -> \\{data\\['html_url'\\]\\}\"\\)\nPY$/": {
